# Dropbox is deliberately absent: the running client rewrites
# /etc/apt/sources.list.d/dropbox.list (with its own key at
# /etc/apt/keyrings/dropbox.asc) on startup, and a second definition here
# makes apt fail with a Signed-By conflict.

Types: deb deb-src
URIs: http://ppa.launchpad.net/phoerious/keepassxc/ubuntu
Suites: resolute
Components: main
Signed-By: /usr/share/keyrings/keepassxc-archive-keyring.gpg

Types: deb
URIs: https://updates.signal.org/desktop/apt
Suites: xenial
Components: main
Architectures: amd64
Signed-By: /usr/share/keyrings/signal-desktop-keyring.gpg

Types: deb
URIs: https://repository.mullvad.net/deb/stable
Suites: stable
Components: main
Architectures: amd64
Signed-By: /usr/share/keyrings/mullvad-keyring.asc

Types: deb
URIs: https://mise.jdx.dev/deb
Suites: stable
Components: main
Architectures: amd64
Signed-By: /etc/apt/keyrings/mise-archive-keyring.gpg

# Daily builds; enable only when wanting a newer nvim than the archive has.
Types: deb deb-src
URIs: https://ppa.launchpadcontent.net/neovim-ppa/unstable/ubuntu
Suites: resolute
Components: main
Enabled: no

