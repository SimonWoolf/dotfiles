# All installed postgresql packages are pgdg builds (including EOL 9.3
# clients the archive does not carry), so this cannot be dropped without
# orphaning them. The key comes from postgresql-client-common rather than a
# hand-installed copy, so dpkg keeps it in place across release upgrades.
Types: deb
URIs: http://apt.postgresql.org/pub/repos/apt
Suites: resolute-pgdg
Components: main
Signed-By: /usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg

# Firefox as a deb rather than Ubuntu's snap stub. Needs the companion pin in
# apt-preferences/mozilla-firefox: without it the archive's transitional
# package wins and silently replaces this with the snap, which cannot read
# dotdirs in $HOME (so local HTML from ~/.local/share/mise etc. fails to open).
Types: deb
URIs: https://ppa.launchpadcontent.net/mozillateam/ppa/ubuntu/
