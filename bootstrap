#!/usr/bin/env ruby

require 'socket'

def desktop?
  Socket.gethostname == 'simon-linuxdesktop'
end
def thinkpad?
  Socket.gethostname == 'simon-thinkpad'
end
def xps?
  # TODO when on xps replace with hostname check
  !thinkpad? && !desktop?
end

HOME = `echo ~`.chomp

files = `ls -a ~/dev/dotfiles`
          .split
          .reject {|f| f.length < 3}
          .reject {|f| f == '.git' || f == '.claude'}
          .select {|f| f[0] == '.'}

puts "symlinking #{files.join(', ')}"

files.each do |file|
  `ln -fs ~/dev/dotfiles/#{file} ~`
end

`ls ~/dev/dotfiles/dotdesktops/`.split.each do |file|
  `ln -fs ~/dev/dotfiles/dotdesktops/#{file} ~/.local/share/applications/`
end

`mkdir -p ~/.config/sway/`
`mkdir -p ~/.config/waybar/`
`mkdir -p ~/.config/alacritty/`
`mkdir -p ~/.config/dunst/`
`mkdir -p ~/.config/fuzzel/`
# fuzzel's popularity cache lives here rather than the default ~/.cache/fuzzel,
# which gets cleared periodically (path set on the launcher's sway bindsym)
`mkdir -p ~/.local/state/`
`mkdir -p ~/.config/xkb/symbols/`
`mkdir -p ~/.config/nvim/`
`ln -fs ~/dev/dotfiles/vim-init.lua ~/.config/nvim/init.lua`
`ln -fs ~/dev/dotfiles/lazy-lock.json ~/.config/nvim/lazy-lock.json`
`ln -fs ~/dev/dotfiles/sway_config ~/.config/sway/config`
`ln -fs ~/dev/dotfiles/waybar_config ~/.config/waybar/config`
`ln -fs ~/dev/dotfiles/waybar_style.css ~/.config/waybar/style.css`
`ln -fs ~/dev/dotfiles/dunstrc ~/.config/dunst/dunstrc`
`ln -fs ~/dev/dotfiles/fuzzel.ini ~/.config/fuzzel/fuzzel.ini`
`ln -fs ~/dev/dotfiles/default-golang-pkgs ~/.default-go-packages`
`ln -fs ~/dev/dotfiles/ssh-config ~/.ssh/config`
`ln -fs ~/Dropbox/bash_history ~/.bash_history`
`mkdir -p ~/.config/nvim-qt/`
`rm ~/.config/nvim-qt/nvim-qt.conf 2> /dev/null`
`ln -fs ~/dev/dotfiles/nvim-qt.conf ~/.config/nvim-qt/nvim-qt.conf`

# Profile directory names are random per machine, so find them via profiles.ini.
# Firefox uses the XDG location for profiles created since 147.
["#{HOME}/.mozilla/firefox", "#{HOME}/.config/mozilla/firefox"].each do |ff_dir|
  ini = "#{ff_dir}/profiles.ini"
  next if !File.exist?(ini)
  File.read(ini).scan(/^Path=(.+)$/).flatten.each do |path|
    profile = File.expand_path(path, ff_dir)
    `mkdir -p "#{profile}/chrome"`
    `ln -fs ~/dev/dotfiles/userChrome.css "#{profile}/chrome/userChrome.css"`
    # user.js sets the pref that makes Firefox load userChrome.css at all
    `ln -fs ~/dev/dotfiles/firefox-user.js "#{profile}/user.js"`
  end
end

private_bootstrap = "#{HOME}/dev/dotfiles-private/bootstrap"
system(private_bootstrap) if File.exist?(private_bootstrap)

# xdg-utils deletes and recreates ~/.config/mimeapps.list when it writes to it, which will break symbolic links
`cp ~/dev/dotfiles/dotdesktops/mimeapps.list ~/.config/mimeapps.list`
# A release upgrade can replace these symlinks with regular files, so relink
# whenever they are not currently symlinks rather than merely absent.
if !File.symlink?('/etc/apt/sources.list.d/custom.sources')
  `sudo ln -fs #{HOME}/dev/dotfiles/apt-custom-sources.sources /etc/apt/sources.list.d/custom.sources`
end
Dir["#{HOME}/dev/dotfiles/apt-preferences/*"].each do |pref|
  target = "/etc/apt/preferences.d/#{File.basename(pref)}"
  `sudo ln -fs #{pref} #{target}` if !File.symlink?(target)
end

`mkdir -p ~/.local/share/wayland-sessions/`
# A user-level session file takes precedence over the sway package's own and,
# unlike editing /usr/share/wayland-sessions/sway.desktop, survives upgrades.
`ln -fs ~/dev/dotfiles/sway-debug.desktop ~/.local/share/wayland-sessions/sway-debug.desktop`
`mkdir -p ~/.local/bin/`
`ln -fs ~/dev/dotfiles/bin/start-sway ~/.local/bin/start-sway`

# nvim backup/undo/swap dirs (paths set in vim-init.lua)
`mkdir -p ~/.vim/nundodir/`
`mkdir -p ~/.vim/_nbackup/`
`mkdir -p ~/.vim/_ntemp/`

if desktop?
  `cat noedit sway_config_base sway_config_desktop > sway_config`
  `ln -fs ~/dev/dotfiles/ginit-desktop.vim ~/.config/nvim/ginit.vim`
  `ln -fs ~/dev/dotfiles/alacritty-desktop.toml ~/.config/alacritty/alacritty.toml`
else
  `cat noedit sway_config_base sway_config_laptop > sway_config`
  `ln -fs ~/dev/dotfiles/xkb_custom_layout ~/.config/xkb/symbols/gb`
  `ln -fs ~/dev/dotfiles/ginit-laptop.vim ~/.config/nvim/ginit.vim`
  `mkdir -p ~/.config/kanshi/`
  `ln -fs ~/dev/dotfiles/kanshi_config ~/.config/kanshi/config`
  `ln -fs ~/dev/dotfiles/alacritty-laptop.toml ~/.config/alacritty/alacritty.toml`
  # Copied rather than linked, as the initramfs needs the file itself.
  nvidia_conf = '/etc/modprobe.d/nvidia-no-fbdev.conf'
  if !system("cmp -s #{HOME}/dev/dotfiles/nvidia-no-fbdev.conf #{nvidia_conf}")
    `sudo install -m644 #{HOME}/dev/dotfiles/nvidia-no-fbdev.conf #{nvidia_conf}`
    `sudo update-initramfs -u`
  end
end
