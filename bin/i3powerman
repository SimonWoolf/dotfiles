#!/bin/sh

# set the theme to adwaita-light on suspend/shutdown so that it's always light
# when waking up the computer, then cron sets it to dark at 8pm

case "$1" in
    lock)
        pgrep sway && swaylock -c 3f3f3f || xflock4
        ;;
    logout)
        # under uwsm, stop the session units in order rather than yanking sway
        case "$(cat /proc/self/cgroup)" in
            *wayland-wm@*) uwsm stop ;;
            *) swaymsg exit ;;
        esac
        ;;
    suspend)
        xfconf-query --channel xsettings --property /Net/ThemeName --set Adwaita
        systemctl suspend
        ;;
    hibernate)
        systemctl hibernate
        ;;
    reboot)
        systemctl reboot
        ;;
    shutdown)
        xfconf-query --channel xsettings --property /Net/ThemeName --set Adwaita
        systemctl poweroff
        ;;
    test)
        notify-send "test"
        ;;
    *)
        echo "Usage: $0 {lock|logout|suspend|hibernate|reboot|shutdown}"
        exit 2
esac

exit 0
