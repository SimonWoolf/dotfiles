#!/usr/bin/env python3
"""Move tasks from a Todoist project into today's Logseq journal, tagged.

Each task becomes a block (subtasks nested under it), and is deleted from
Todoist only once it and all its subtasks have been uploaded to Logseq sync.
"""

import datetime
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request

CONFIG_PATH = os.environ.get(
    "TODOIST_TO_LOGSEQ_CONFIG",
    os.path.expanduser("~/.config/todoist-to-logseq/config.json"),
)
TODOIST_API = "https://api.todoist.com/api/v1/"
JOURNAL_TITLE_FORMAT = "MMM do, yyyy"
SYNC_TIMEOUT_SECS = 120


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def load_config():
    with open(CONFIG_PATH) as f:
        config = json.load(f)
    config.setdefault("graph", "notes")
    config.setdefault("tag", "inbox")
    config.setdefault(
        "logseq",
        shutil.which("logseq") or os.path.expanduser("~/.local/bin/logseq"),
    )
    return config


def todoist(config, method, path):
    req = urllib.request.Request(
        TODOIST_API + path,
        method=method,
        headers={"Authorization": "Bearer " + config["token"]},
    )
    with urllib.request.urlopen(req, timeout=30) as resp:
        body = resp.read()
    return json.loads(body) if body else None


def fetch_tasks(config):
    tasks, cursor = [], None
    while True:
        path = f"tasks?project_id={config['project_id']}&limit=200"
        if cursor:
            path += f"&cursor={cursor}"
        page = todoist(config, "GET", path)
        tasks += page["results"]
        cursor = page.get("next_cursor")
        if not cursor:
            return tasks


def delete_task(config, task_id):
    try:
        todoist(config, "DELETE", f"tasks/{task_id}")
    except urllib.error.HTTPError as e:
        # Deleting a parent also deletes its subtasks, so they may already be gone.
        if e.code != 404:
            raise


def logseq(config, *args):
    result = subprocess.run(
        [config["logseq"], *args, "-g", config["graph"], "-o", "json"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        raise RuntimeError(
            f"logseq {' '.join(args[:2])} failed: {result.stderr.strip() or result.stdout.strip()}"
        )
    return json.loads(result.stdout)["data"]


def graph_server_running(config):
    servers = logseq(config, "server", "list")["servers"]
    return any(s["graph"] == config["graph"] for s in servers)


def wait_for_sync(config, what, done):
    deadline = time.monotonic() + SYNC_TIMEOUT_SECS
    while True:
        status = logseq(config, "sync", "status")
        if status.get("ws-state") == "open" and done(status):
            return
        if time.monotonic() > deadline:
            raise RuntimeError(f"timed out waiting for sync to {what}: {status}")
        time.sleep(1)


def sync_caught_up(config):
    if logseq(config, "sync", "status").get("ws-state") != "open":
        # Uses the E2EE password the Logseq app saved in the system keyring.
        logseq(config, "sync", "start")
    # Blocks written while behind the server get rebased when sync catches up,
    # which drops their tags.
    wait_for_sync(
        config,
        "catch up",
        lambda s: s["local-tx"] == s["remote-tx"] and s["pending-local"] == 0,
    )


def ordinal(n):
    if 11 <= n % 100 <= 13:
        return f"{n}th"
    return f"{n}{ {1: 'st', 2: 'nd', 3: 'rd'}.get(n % 10, 'th') }"


def journal_title(config, date):
    # The CLI creates a journal page when given a title in the graph's journal
    # format, so we need to produce exactly that format.
    fmt = logseq(
        config,
        "query",
        "--query",
        "[:find ?v . :where [?e :db/ident :logseq.class/Journal]"
        " [?e :logseq.property.journal/title-format ?v]]",
    )["result"]
    if fmt != JOURNAL_TITLE_FORMAT:
        raise RuntimeError(
            f"graph journal title format is {fmt!r}, only {JOURNAL_TITLE_FORMAT!r} is supported"
        )
    return f"{date.strftime('%b')} {ordinal(date.day)}, {date.year}"


def block_content(task):
    description = (task.get("description") or "").strip()
    return f"{task['content']}\n{description}" if description else task["content"]


def insert_task(config, task, children, target):
    """Insert task and its subtasks; target is the journal page title for a
    top-level task, or the parent's block id for a subtask."""
    if task.get("parent_id"):
        args = ["--target-id", str(target), "--pos", "last-child"]
    else:
        args = ["--target-page", target, "--update-tags", json.dumps([config["tag"]])]
    [block_id] = logseq(
        config, "upsert", "block", *args, "--content", block_content(task)
    )["result"]
    inserted = [task["id"]]
    for child in children.get(task["id"], []):
        inserted += insert_task(config, child, children, block_id)
    return inserted


def main():
    config = load_config()
    tasks = fetch_tasks(config)
    if not tasks:
        return

    ids = {t["id"] for t in tasks}
    children = {}
    for t in sorted(tasks, key=lambda t: t.get("child_order", 0)):
        if t.get("parent_id") in ids:
            children.setdefault(t["parent_id"], []).append(t)
    roots = sorted(
        (t for t in tasks if t.get("parent_id") not in ids),
        key=lambda t: t.get("added_at") or "",
    )

    server_was_running = graph_server_running(config)
    failed = False
    try:
        sync_caught_up(config)
        page = journal_title(config, datetime.date.today())
        moved = []
        for root in roots:
            try:
                # A root is only deleted once its whole subtree is in the graph,
                # since deleting it in Todoist deletes its subtasks too.
                moved.append((root, insert_task(config, root, children, page)))
            except Exception as e:
                failed = True
                log(f"failed to add {root['content']!r}, leaving it in Todoist: {e}")
        if moved:
            wait_for_sync(config, "upload", lambda s: s["pending-local"] == 0)
        for root, inserted in moved:
            delete_task(config, root["id"])
            log(f"moved {root['content']!r} ({len(inserted)} block(s))")
    finally:
        if not server_was_running:
            logseq(config, "server", "stop")

    if failed:
        sys.exit(1)


if __name__ == "__main__":
    main()
