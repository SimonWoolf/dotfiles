#!/bin/bash
exec 1> >(tee "/tmp/sway-$(date +%s).log")
exec 2>&1
echo "Starting Sway..."
env

export XDG_CURRENT_DESKTOP=sway # xdg-desktop-portal
export XDG_SESSION_DESKTOP=sway # systemd
export XDG_SESSION_TYPE=wayland # xdg/systemd

dbus-update-activation-environment XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE

# without this, systemd starts xdg-desktop-portal without these environment variables,
# and the xdg-desktop-portal does not start xdg-desktop-portal-wrl as expected
# https://github.com/emersion/xdg-desktop-portal-wlr/issues/39#issuecomment-638752975
systemctl --user import-environment XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE

# Hybrid graphics: sway-gpu picks which cards the compositor drives (by
# default only the integrated one, so the NVIDIA card can runtime-suspend to
# D3cold, worth ~20W idle on the X1E). Single-GPU machines are left alone.
if [ -d /proc/driver/nvidia ]; then
    # sway refuses to start at all while the proprietary modules are loaded
    sway_args=(--unsupported-gpu)
    devices=$("$(dirname "$(readlink -f "$0")")/sway-gpu" drm-devices)
    [ -n "$devices" ] && export WLR_DRM_DEVICES="$devices"
fi

exec sway -d "${sway_args[@]}" "$@"
