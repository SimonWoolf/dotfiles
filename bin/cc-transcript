#!/usr/bin/env python3
"""Render a Claude Code JSONL transcript as Markdown or standalone HTML.

Usage:
  cc-transcript [options] [SESSION]

SESSION may be a path to a .jsonl file, a session id, or omitted to pick the
most recently modified transcript for the current directory's project. Use
"--" before a path that starts with a dash.

Options:
  -f, --format md|html   output format (default: md)
  -o, --out FILE         write to FILE (default: stdout)
  -l, --list             list transcripts for this project and exit
  --project DIR          use DIR's project instead of the cwd
  --all-projects         with --list, list every project's transcripts
  --tool-output N        max chars of each tool result to keep (default 2000,
                         0 = drop results, -1 = keep in full)
  --no-thinking          omit thinking blocks
  --no-tools             omit tool calls and results entirely
  --no-sidechains        omit subagent (sidechain) messages
  --no-system            omit system-injected records (subagent completion
                         notifications, command output, meta messages)
  --fold-lines N         fold Claude responses longer than N lines (default 5)
  --fold-chars N         also fold responses longer than N chars (default 600)
  --no-fold              never fold responses
  --start TEXT           begin output at the first message containing TEXT
  --end TEXT             stop after the last message containing TEXT
                         (both match user and Claude messages, case- and
                         whitespace-insensitively; the range is inclusive)
  --meta                 include injected/meta messages
"""
import argparse
import html
import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path

PROJECTS = Path.home() / ".claude" / "projects"


def project_dir(path: Path) -> Path:
    """Claude Code encodes the cwd by replacing non-alphanumerics with dashes."""
    return PROJECTS / re.sub(r"[^a-zA-Z0-9]", "-", str(path.resolve()))


def transcripts(d: Path):
    if not d.is_dir():
        return []
    return sorted(d.glob("*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)


def load(path: Path):
    records = []
    with path.open() as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                records.append(json.loads(line))
            except json.JSONDecodeError:
                continue
    return records


def title_of(records):
    for r in records:
        if r.get("type") == "ai-title" and r.get("title"):
            return r["title"]
    for r in records:
        if r.get("type") == "user" and not r.get("isMeta"):
            t = text_of(r.get("message", {}))
            if t:
                return t.strip().splitlines()[0][:80]
    return "Claude Code transcript"


def text_of(message):
    content = message.get("content")
    if isinstance(content, str):
        return content
    parts = []
    for block in content or []:
        if isinstance(block, dict) and block.get("type") == "text":
            parts.append(block.get("text", ""))
    return "\n".join(parts)


def result_text(block):
    content = block.get("content")
    if isinstance(content, str):
        return content
    parts = []
    for sub in content or []:
        if not isinstance(sub, dict):
            continue
        if sub.get("type") == "text":
            parts.append(sub.get("text", ""))
        elif sub.get("type") == "image":
            parts.append("[image]")
    return "\n".join(parts)


def strip_reminders(s):
    return re.sub(r"<system-reminder>.*?</system-reminder>", "", s, flags=re.S).strip()


def clip(s, limit):
    """limit 0 drops the text entirely; negative means unlimited."""
    if limit == 0:
        return ""
    if limit > 0 and len(s) > limit:
        return s[:limit] + f"\n… [{len(s) - limit} more chars]"
    return s


def fmt_time(ts):
    if not ts:
        return ""
    try:
        return datetime.fromisoformat(ts.replace("Z", "+00:00")).strftime("%Y-%m-%d %H:%M")
    except ValueError:
        return ts


def tool_summary(name, inp):
    """One-line gist of a tool call, for the collapsed header."""
    if not isinstance(inp, dict):
        return name
    for key in ("command", "file_path", "pattern", "path", "url", "description", "prompt", "skill"):
        v = inp.get(key)
        if isinstance(v, str) and v.strip():
            v = " ".join(v.split())
            return f"{name}: {v[:120]}"
    return name


SLASH_RE = re.compile(r"<command-name>(.*?)</command-name>", re.S)
SLASH_ARGS_RE = re.compile(r"<command-args>(.*?)</command-args>", re.S)
TAG_RE = re.compile(r"^<([a-z-]+)>")


def tag_of(text):
    m = TAG_RE.match(text)
    return m.group(1) if m else None


def inner(text, tag):
    m = re.search(rf"<{tag}>(.*?)</{tag}>", text, re.S)
    return (m.group(1) if m else text).strip()


def classify_user(rec, text):
    """Real human turn, or a system-injected record wearing a user role?

    origin.kind is authoritative where present, but it is a newer field absent
    from older transcripts, so fall back to the wrapper tag.
    """
    tag = tag_of(text)
    origin = rec.get("origin")
    kind = origin.get("kind") if isinstance(origin, dict) else None

    if tag == "task-notification" or kind == "task-notification":
        return "notification", text
    if tag == "bash-notification":
        return "notification", text
    if tag in ("command-name", "command-message"):
        name = SLASH_RE.search(text)
        args = SLASH_ARGS_RE.search(text)
        label = (name.group(1) if name else inner(text, tag)).strip()
        arg = (args.group(1).strip() if args else "")
        return "slash", (label + (" " + arg if arg else "")).strip()
    if tag == "bash-input":
        return "bash_in", inner(text, tag)
    if tag in ("bash-stdout", "local-command-stdout"):
        return "cmd_out", inner(text, tag)
    if tag == "local-command-stderr":
        return "cmd_err", inner(text, tag)
    if tag in ("local-command-caveat", "interrupted-output"):
        return "drop", text
    if kind == "human":
        return "human", text
    if rec.get("promptSource") in ("typed", "queued"):
        return "human", text
    if rec.get("isMeta") or rec.get("promptSource") == "system":
        return "system", text
    return "human", text


def summarize_notification(text):
    """Pull the agent summary and result out of a task/bash notification."""
    def grab(t):
        m = re.search(rf"<{t}>(.*?)</{t}>", text, re.S)
        return m.group(1).strip() if m else ""
    return grab("summary") or "background task", grab("result") or grab("status")


def fold_info(text, max_lines, max_chars):
    """Should this response fold, and what are the preview / remainder halves?

    Long text wraps, so a response can dominate the page without having many
    newlines; length is checked alongside the line count.
    """
    body = text.strip()
    lines = body.splitlines()
    if len(lines) <= max_lines and len(body) <= max_chars:
        return False, body, ""
    cut = max_lines
    # Don't split inside a fenced code block: an unbalanced ``` would leak a bare
    # fence marker into the preview and swallow the formatting of the rest.
    if sum(1 for ln in lines[:cut] if ln.lstrip().startswith("```")) % 2:
        while cut > 0 and not lines[cut - 1].lstrip().startswith("```"):
            cut -= 1
        cut = max(cut - 1, 0)
        if cut == 0:
            cut = max_lines
            while cut < len(lines) and not lines[cut].lstrip().startswith("```"):
                cut += 1
            cut = min(cut + 1, len(lines))
    preview = "\n".join(lines[:cut])
    rest = "\n".join(lines[cut:])
    # A single long paragraph has no newline to split on; break it on length so
    # the preview is a real excerpt rather than the whole wall of text.
    if not rest and len(preview) > max_chars:
        cut = preview.rfind(" ", 0, max_chars)
        cut = cut if cut > max_chars // 2 else max_chars
        preview, rest = preview[:cut].rstrip(), preview[cut:].lstrip()
    return True, preview, rest


def events(records, opts):
    """Flatten records into (kind, payload) events in transcript order."""
    results = {}
    for r in records:
        if r.get("type") == "user":
            for b in r.get("message", {}).get("content") or []:
                if isinstance(b, dict) and b.get("type") == "tool_result":
                    results[b.get("tool_use_id")] = b

    for r in records:
        kind = r.get("type")
        if kind not in ("user", "assistant"):
            continue
        if r.get("isSidechain") and opts.no_sidechains:
            continue
        if r.get("isMeta") and not opts.meta:
            continue
        msg = r.get("message") or {}
        side = bool(r.get("isSidechain"))
        ts = fmt_time(r.get("timestamp"))

        if kind == "user":
            body = strip_reminders(text_of(msg))
            if not body:
                continue
            what, payload = classify_user(r, body)
            if what == "drop":
                continue
            if what == "human":
                yield ("user", {"text": payload, "time": ts, "side": side})
            elif what == "notification":
                if not opts.no_system:
                    label, result = summarize_notification(payload)
                    yield ("notification", {"label": label, "text": clip(result, opts.tool_output),
                                            "time": ts, "side": side})
            elif what == "slash":
                yield ("slash", {"text": payload, "time": ts, "side": side})
            elif what in ("bash_in", "cmd_out", "cmd_err"):
                if not opts.no_system:
                    yield (what, {"text": clip(payload, opts.tool_output), "time": ts, "side": side})
            elif not opts.no_system:
                yield ("system", {"text": payload, "time": ts, "side": side})
            continue

        content = msg.get("content")
        if isinstance(content, str):
            content = [{"type": "text", "text": content}]
        for b in content or []:
            if not isinstance(b, dict):
                continue
            bt = b.get("type")
            if bt == "text" and b.get("text", "").strip():
                yield ("assistant", {"text": b["text"], "time": ts, "side": side})
            elif bt == "thinking" and not opts.no_thinking:
                thought = b.get("thinking", "").strip()
                if thought:
                    yield ("thinking", {"text": thought, "time": ts, "side": side})
            elif bt == "tool_use" and not opts.no_tools:
                res = results.get(b.get("id"))
                out = clip(result_text(res), opts.tool_output) if res else ""
                yield ("tool", {
                    "name": b.get("name", "tool"),
                    "input": b.get("input"),
                    "summary": tool_summary(b.get("name", "tool"), b.get("input")),
                    "output": out,
                    "error": bool(res and res.get("is_error")),
                    "time": ts,
                    "side": side,
                })


def event_text(kind, e):
    """The matchable text of an event, for --start/--end."""
    if kind == "notification":
        return f"{e.get('label', '')}\n{e.get('text', '')}"
    return e.get("text", "")


def slice_events(stream, start, end):
    """Trim the event stream to the range delimited by --start / --end.

    Matching is case-insensitive on normalised whitespace, so a marker can be
    copy-pasted out of rendered output without worrying about wrapping. The
    marker matches an event that *contains* it; the range is inclusive.
    """
    def norm(t):
        return " ".join((t or "").split()).lower()

    items = list(stream)
    lo, hi = 0, len(items)
    if start:
        want = norm(start)
        # A marker copy-pasted from the top of a response should anchor to that
        # response, not to an earlier passing mention of the same words.
        texts = [norm(event_text(k, e)) for k, e in items]
        lo = next((i for i, t in enumerate(texts) if t.startswith(want)),
                  next((i for i, t in enumerate(texts) if want in t), None))
        if lo is None:
            sys.exit(f"cc-transcript: --start text not found: {start!r}")
    if end:
        want = norm(end)
        tail = [norm(event_text(k, e)) for k, e in items[lo:]]
        rel = next((i for i in range(len(tail) - 1, -1, -1) if tail[i].startswith(want)),
                   next((i for i in range(len(tail) - 1, -1, -1) if want in tail[i]), None))
        if rel is None:
            sys.exit(f"cc-transcript: --end text not found at or after --start: {end!r}")
        hi = lo + rel + 1
    return items[lo:hi]


def render_md(records, opts, title, path):
    out = [f"# {title}", "", f"*Session `{path.stem}`*", ""]
    for kind, e in slice_events(events(records, opts), opts.start, opts.end):
        tag = " *(subagent)*" if e["side"] else ""
        if kind == "user":
            out += [f"## 👤 User{tag}", "", e["text"], ""]
        elif kind == "assistant":
            folds, preview, rest = fold_info(e["text"], opts.fold_lines, opts.fold_chars)
            out += [f"### 🤖 Claude{tag}", ""]
            if folds:
                # A <summary> holding block markdown (headings, lists) breaks out of
                # the element on GitHub, so the teaser is one flattened line and the
                # full text lives inside.
                teaser = " ".join(preview.split())
                if len(teaser) > 160:
                    teaser = teaser[:160].rstrip() + "…"
                out += [f"<details><summary>{teaser}</summary>", "",
                        (preview + ("\n" + rest if rest else "")), "", "</details>", ""]
            else:
                out += [preview, ""]
        elif kind == "thinking":
            out += ["<details><summary>💭 Thinking</summary>", "",
                    "> " + e["text"].replace("\n", "\n> "), "", "</details>", ""]
        elif kind == "tool":
            head = ("❌ " if e["error"] else "🔧 ") + e["summary"]
            out += [f"<details><summary>{head}</summary>", "", "```json",
                    json.dumps(e["input"], indent=2, default=str), "```"]
            if e["output"]:
                out += ["", "```", e["output"], "```"]
            out += ["", "</details>", ""]
        elif kind == "slash":
            out += [f"## 👤 User{tag}", "", f"`{e['text']}`", ""]
        elif kind == "notification":
            out += [f"<details><summary>🔔 {e['label']}</summary>", ""]
            if e["text"]:
                out += ["```", e["text"], "```", ""]
            out += ["</details>", ""]
        elif kind == "bash_in":
            out += ["**`!` command**", "", "```bash", e["text"], "```", ""]
        elif kind in ("cmd_out", "cmd_err"):
            label = "command stderr" if kind == "cmd_err" else "command output"
            out += [f"<details><summary>{label}</summary>", "", "```", e["text"], "```", "",
                    "</details>", ""]
        elif kind == "system":
            out += ["<details><summary>⚙️ system message</summary>", "", "```", e["text"],
                    "```", "", "</details>", ""]
    return "\n".join(out)


CSS = """
