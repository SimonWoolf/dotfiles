.time { float:right; font-size:.72rem; color:var(--muted); font-weight:400; letter-spacing:0; text-transform:none; }
"""


def md_inline(s):
    """Minimal markdown for assistant text: fences, inline code, bold, headings, links."""
    parts = re.split(r"(```.*?```)", s, flags=re.S)
    out = []
    for i, part in enumerate(parts):
        if i % 2:
            body = part[3:-3]
            first, _, rest = body.partition("\n")
            if re.fullmatch(r"[\w+-]*", first.strip()):
                body = rest
            out.append(f"<pre>{html.escape(body.strip())}</pre>")
            continue
        t = html.escape(part)
        # Code spans are extracted before the other rules run: a span like
        # `containers/**` otherwise feeds its ** to the bold rule, which pairs it
        # with a later ** and emits tags that interleave with the <code>.
        spans = []

        def stash(m):
            spans.append(m.group(1))
            return f"\x00{len(spans) - 1}\x00"

        t = re.sub(r"`([^`\n]+)`", stash, t)
        t = re.sub(r"\*\*([^*\n]+)\*\*", r"<strong>\1</strong>", t)
        t = re.sub(r"\[([^\]]+)\]\((https?://[^)]+)\)", r'<a href="\2">\1</a>', t)
        t = re.sub(r"^(#{1,6})\s+(.*)$",
                   lambda m: f"<strong>{m.group(2)}</strong>", t, flags=re.M)
        t = t.replace("\n", "<br>")
        t = re.sub(r"\x00(\d+)\x00", lambda m: f"<code>{spans[int(m.group(1))]}</code>", t)
        out.append(t)
    return "".join(out)


def render_html(records, opts, title, path):
    esc = html.escape
    o = [f"<!doctype html><html><head><meta charset=utf-8>",
         '<meta name="viewport" content="width=device-width,initial-scale=1">',
         f"<title>{esc(title)}</title><style>{CSS}</style></head><body><main>",
         f"<h1>{esc(title)}</h1>",
         f'<div class="sub">Session <code>{esc(path.stem)}</code></div>']
    for kind, e in slice_events(events(records, opts), opts.start, opts.end):
        side = " side" if e["side"] else ""
        tm = f'<span class="time">{esc(e["time"])}</span>' if e["time"] else ""
        if kind == "user":
            o.append(f'<div class="msg{side}"><div class="who">User{tm}</div>'
                     f'<div class="user"><div class="body">{esc(e["text"])}</div></div></div>')
        elif kind == "assistant":
            folds, preview, rest = fold_info(e["text"], opts.fold_lines, opts.fold_chars)
            o.append(f'<div class="msg{side}"><div class="who">Claude{tm}</div>')
            if folds:
                lh = opts.fold_lines
                o.append(f'<details class="resp"><summary><span class="peek" '
                         f'style="--peek:{lh}">{md_inline(preview)}</span>'
                         f'<span class="more"></span></summary>'
                         f'<div class="body">{md_inline(preview)}'
                         f'{md_inline(chr(10) + rest) if rest else ""}</div></details>')
            else:
                o.append(f'<div class="body">{md_inline(preview)}</div>')
            o.append('</div>')
        elif kind == "thinking":
            o.append(f'<details class="think{side}"><summary>Thinking</summary>'
                     f'<div class="inner">{esc(e["text"])}</div></details>')
        elif kind == "tool":
            cls = " err" if e["error"] else ""
            inner = f"<pre>{esc(json.dumps(e['input'], indent=2, default=str))}</pre>"
            if e["output"]:
                inner += f"<pre>{esc(e['output'])}</pre>"
            o.append(f'<details class="tool{cls}{side}"><summary>{esc(e["summary"])}</summary>'
                     f'<div class="inner">{inner}</div></details>')
        elif kind == "slash":
            o.append(f'<div class="msg{side}"><div class="who">User{tm}</div>'
                     f'<div class="user"><div class="body"><code>{esc(e["text"])}</code>'
                     f'</div></div></div>')
        elif kind == "notification":
            body = f"<pre>{esc(e['text'])}</pre>" if e["text"] else ""
            o.append(f'<details class="note{side}"><summary>🔔 {esc(e["label"])}</summary>'
                     f'<div class="inner">{body}</div></details>')
        elif kind == "bash_in":
            o.append(f'<div class="msg{side}"><div class="who">! command{tm}</div>'
                     f'<pre class="bashin">{esc(e["text"])}</pre></div>')
        elif kind in ("cmd_out", "cmd_err"):
            label = "command stderr" if kind == "cmd_err" else "command output"
            cls2 = " err" if kind == "cmd_err" else ""
            o.append(f'<details class="tool{cls2}{side}"><summary>{label}</summary>'
                     f'<div class="inner"><pre>{esc(e["text"])}</pre></div></details>')
        elif kind == "system":
            o.append(f'<details class="sys{side}"><summary>system message</summary>'
                     f'<div class="inner"><pre>{esc(e["text"])}</pre></div></details>')
    o.append("</main></body></html>")
    return "\n".join(o)


def resolve(session, proj):
    if session:
        p = Path(session)
        if p.is_file():
            return p
        for d in ([proj] if proj.is_dir() else []) + sorted(PROJECTS.iterdir()):
            if not d.is_dir():
                continue
            cand = d / f"{session}.jsonl"
            if cand.is_file():
                return cand
        sys.exit(f"cc-transcript: no transcript found for {session!r}")
    found = transcripts(proj)
    if not found:
        sys.exit(f"cc-transcript: no transcripts in {proj}")
    return found[0]


def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("session", nargs="?")
    ap.add_argument("-f", "--format", choices=["md", "html"], default="md")
    ap.add_argument("-o", "--out")
    ap.add_argument("-l", "--list", action="store_true")
    ap.add_argument("--project", default=".")
    ap.add_argument("--all-projects", action="store_true")
    ap.add_argument("--tool-output", type=int, default=2000)
    ap.add_argument("--no-thinking", action="store_true")
    ap.add_argument("--no-tools", action="store_true")
    ap.add_argument("--no-sidechains", action="store_true")
    ap.add_argument("--no-system", action="store_true")
    ap.add_argument("--fold-lines", type=int, default=5)
    ap.add_argument("--fold-chars", type=int, default=600)
    ap.add_argument("--no-fold", action="store_true")
    ap.add_argument("--start")
    ap.add_argument("--end")
    ap.add_argument("--meta", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    argv = sys.argv[1:]
    # A session path may begin with "-" (projects like /tmp map to "-tmp"), which
    # argparse would read as a flag; anything after "--" is taken literally.
    if "--" in argv:
        i = argv.index("--")
        rest = argv[i + 1:]
        opts = ap.parse_args(argv[:i])
        if rest:
            opts.session = rest[0]
    else:
        opts = ap.parse_args(argv)
    if opts.help:
        print(__doc__)
        return

    if opts.no_fold:
        opts.fold_lines = opts.fold_chars = float("inf")

    proj = project_dir(Path(opts.project))

    if opts.list:
        dirs = sorted(PROJECTS.iterdir()) if opts.all_projects else [proj]
        for d in dirs:
            for p in transcripts(d):
                recs = load(p)
                mtime = datetime.fromtimestamp(p.stat().st_mtime).strftime("%Y-%m-%d %H:%M")
                size = p.stat().st_size // 1024
                label = f"{d.name}/" if opts.all_projects else ""
                print(f"{mtime}  {size:>6}K  {label}{p.stem}  {title_of(recs)[:70]}")
        return

    path = resolve(opts.session, proj)
    records = load(path)
    title = title_of(records)
    render = render_html if opts.format == "html" else render_md
    text = render(records, opts, title, path)
    if opts.out:
        Path(opts.out).write_text(text)
        print(f"wrote {opts.out} ({len(text) // 1024}K)", file=sys.stderr)
    else:
        print(text)


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        # Piping into head/less closes stdout early; exit quietly rather than
        # letting the interpreter report the failed flush at shutdown.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)
    except KeyboardInterrupt:
        sys.exit(130)
