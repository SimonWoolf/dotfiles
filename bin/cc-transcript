        --user:#eef2f8; --userline:#4a72b0; --think:#f4f1ea; --tool:#f3f4f4; --err:#b3261e; }
@media (prefers-color-scheme: dark) {
  :root { --bg:#191817; --fg:#e8e6e3; --muted:#9b9691; --line:#332f2d;
          --user:#1e2733; --userline:#5b86c9; --think:#241f19; --tool:#212322; --err:#f2b8b5; }
}
* { box-sizing: border-box; }
